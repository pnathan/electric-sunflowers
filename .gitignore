# Vendored crates are committed whole: cargo checks every file against its checksum.
!/vendor/**

# Bazel convenience symlinks (bazel-bin, bazel-out, bazel-<repo name>, ...).
/bazel-*
# Local-only Bazel overrides (e.g. a BuildBuddy API key). See .bazelrc.
.bazelrc.local
.claude/settings.local.json
# Claude Code agent worktrees (scratch checkouts for background agents).
.claude/worktrees/
