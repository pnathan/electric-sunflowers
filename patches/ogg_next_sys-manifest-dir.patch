+	// rules_rust propagates a DEP_<LINKS>_* variable (here DEP_OGG_INCLUDE,
+	// read by aotuv_lancer_vorbis_sys's build.rs) to a downstream build
+	// script's sandbox only when it points inside this crate's OUT_DIR (a
