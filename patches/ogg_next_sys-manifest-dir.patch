@@ -1,12 +1,34 @@
-use std::env::current_dir;
+use std::env;
+use std::fs;
+use std::path::{Path, PathBuf};
+
+// Bazel's cargo_build_script does not run build scripts with the crate's
+// manifest directory as the process cwd (unlike Cargo), so `current_dir()`
+// resolves to the wrong place there (see the same fix in
+// aotuv_lancer_vorbis_sys, which depends on this crate's DEP_OGG_INCLUDE).
+// CARGO_MANIFEST_DIR is set correctly by both Cargo and rules_rust.
+fn manifest_dir() -> PathBuf {
+	PathBuf::from(env::var_os("CARGO_MANIFEST_DIR").expect("CARGO_MANIFEST_DIR not set"))
+}
+
+fn copy_dir_recursive(src: &Path, dst: &Path) {
+	fs::create_dir_all(dst).expect("could not create directory");
+	for entry in fs::read_dir(src).expect("could not read directory") {
+		let entry = entry.expect("could not read directory entry");
+		let dst_path = dst.join(entry.file_name());
+		if entry.file_type().expect("could not read file type").is_dir() {
+			copy_dir_recursive(&entry.path(), &dst_path);
+		} else {
+			fs::copy(entry.path(), &dst_path).expect("could not copy file");
+		}
+	}
+}
 
