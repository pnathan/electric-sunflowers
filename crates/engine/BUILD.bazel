load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# src/lib.rs embeds these at compile time (include_str!("demo.json"),
# include_str!("demo_duet.json")); other crates' tests also reach them via
# relative include_str!("../../engine/src/demo.json") etc., so they need to
# be visible to other packages too.
exports_files(["src/demo.json", "src/demo_duet.json"])

ENGINE_LOCAL_DEPS = [
    "//crates/core:sfcore",
    "//crates/song",
    "//crates/compose",
    "//crates/dsp",
    "//crates/instruments",
    "//crates/voice",
    "//crates/arrange",
]

rust_library(
    name = "engine",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["src/demo.json", "src/demo_duet.json"],
    edition = "2021",
    deps = ENGINE_LOCAL_DEPS + all_crate_deps(normal = True),
)

rust_test(
    name = "engine_unit_tests",
    compile_data = ["src/demo.json", "src/demo_duet.json"],
    crate = ":engine",
    edition = "2021",
    deps = ["//crates/songwriter"] + all_crate_deps(normal_dev = True),
)

rust_test(
    name = "mixer",
    # Full-song renders, unoptimised under fastbuild; they exceed the default 300 s on a CI runner.
    timeout = "long",
    srcs = ["tests/mixer.rs"],
    edition = "2021",
    deps = [":engine"] + ENGINE_LOCAL_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "render_test",
    # Full-song renders, unoptimised under fastbuild; they exceed the default 300 s on a CI runner.
    timeout = "long",
    srcs = ["tests/render_test.rs"],
    edition = "2021",
    deps = [":engine"] + ENGINE_LOCAL_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "sheet_test",
    srcs = ["tests/sheet.rs"],
    edition = "2021",
    deps = [":engine"] + ENGINE_LOCAL_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "choir_test",
    timeout = "long",
    srcs = ["tests/choir.rs"],
    edition = "2021",
    deps = [":engine"] + ENGINE_LOCAL_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "duet_test",
    srcs = ["tests/duet.rs"],
    edition = "2021",
    deps = [":engine"] + ENGINE_LOCAL_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Sound gate stems: renders the demo song and writes each processed stem.
rust_binary(
    name = "stems",
    srcs = ["examples/stems.rs"],
    edition = "2021",
    deps = [":engine"] + ENGINE_LOCAL_DEPS + all_crate_deps(normal = True),
)

# Vocal balance probe against the accompaniment (see CLAUDE.md open issue 1).
rust_binary(
    name = "balance",
    srcs = ["examples/balance.rs"],
    edition = "2021",
    deps = [
        ":engine",
        "//crates/songwriter",
    ] + ENGINE_LOCAL_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Prints the arranger pass's view of a song (no model call).
rust_binary(
    name = "arranger_view",
    srcs = ["examples/arranger_view.rs"],
    edition = "2021",
    deps = [
        ":engine",
        "//crates/songwriter",
    ] + ENGINE_LOCAL_DEPS + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Single harp notes through the engine's harp chain, for tools/harp_compare.py.
rust_binary(
    name = "harpnotes",
    srcs = ["examples/harpnotes.rs"],
    edition = "2021",
    deps = [":engine"] + ENGINE_LOCAL_DEPS + all_crate_deps(normal = True),
)
