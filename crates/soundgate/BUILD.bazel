load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "soundgate_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "soundgate",
    edition = "2021",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "soundgate_unit_tests",
    crate = ":soundgate_lib",
    edition = "2021",
)

rust_binary(
    name = "soundgate",
    srcs = ["src/main.rs"],
    edition = "2021",
    deps = [":soundgate_lib"] + all_crate_deps(normal = True),
)
